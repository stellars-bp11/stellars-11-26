rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function activeMember() {
      return hasProfile() && get(profilePath()).data.isActive == true;
    }

    function currentRole() {
      return get(profilePath()).data.role;
    }

    function isAdmin() {
      return activeMember() && currentRole() in ['admin', 'superAdmin', 'super_admin'];
    }

    function isSuperAdmin() {
      return activeMember() && currentRole() in ['superAdmin', 'super_admin'];
    }

    // Only the explicitly designated SuperAdmin account can review anonymous Letters authorship.
    function isLetterModerator() {
      return isSuperAdmin() && get(profilePath()).data.canModerateLetters == true;
    }

    // A trusted profile flag grants Library editing only, without admin privileges elsewhere.
    function canManageLibrary() {
      return isSuperAdmin() ||
        (activeMember() && get(profilePath()).data.canManageLibrary == true);
    }

    function isStudent() {
      return activeMember() && currentRole() == 'student';
    }

    function validActivationCodeCreate() {
      let data = request.resource.data;
      let nimPath = /databases/$(database)/documents/nimIndex/$(data.nim);
      return isAdmin() &&
        data.keys().hasAll(['fullName', 'nim', 'status', 'createdAt', 'createdBy']) &&
        data.keys().hasOnly(['fullName', 'nim', 'status', 'createdAt', 'createdBy']) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.nim is string &&
        data.nim.matches('^[0-9]{5,24}$') &&
        data.status == 'available' &&
        data.createdAt is timestamp &&
        data.createdBy == request.auth.uid;
    }

    function validStudentProfileCreate(userId) {
      let data = request.resource.data;
      let activationPath = /databases/$(database)/documents/activationCodes/$(data.activationCodeHash);
      let activation = getAfter(activationPath);
      let nimIndexPath = /databases/$(database)/documents/nimIndex/$(data.nim);
      let nimIndex = getAfter(nimIndexPath);
      return signedIn() &&
        request.auth.uid == userId &&
        data.keys().hasAll([
          'fullName', 'username', 'nim', 'role', 'isActive',
          'birthDate', 'slogan', 'activationCodeHash', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'fullName', 'username', 'nim', 'role', 'isActive',
          'birthDate', 'slogan', 'activationCodeHash', 'createdAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.nim is string &&
        data.nim.matches('^[0-9]{5,24}$') &&
        data.username == data.nim &&
        data.role == 'student' &&
        data.isActive == true &&
        data.birthDate == '' &&
        data.slogan == '' &&
        data.activationCodeHash is string &&
        data.activationCodeHash.matches('^[0-9a-f]{64}$') &&
        data.createdAt is timestamp &&
        existsAfter(activationPath) &&
        activation.data.status == 'redeemed' &&
        activation.data.redeemedBy == userId &&
        activation.data.nim == data.nim &&
        activation.data.fullName == data.fullName &&
        existsAfter(nimIndexPath) &&
        nimIndex.data.uid == userId &&
        nimIndex.data.fullName == data.fullName &&
        nimIndex.data.isActive == true;
    }

    function validActivationCodeRedemption(codeHash) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = getAfter(profilePath);
      let profileHasActivationHash = 'activationCodeHash' in profile.data.keys();
      return signedIn() &&
        resource.data.status == 'available' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedBy', 'redeemedAt']) &&
        request.resource.data.status == 'redeemed' &&
        request.resource.data.redeemedBy == request.auth.uid &&
        request.resource.data.redeemedAt is timestamp &&
        existsAfter(profilePath) &&
        (!profileHasActivationHash || profile.data.activationCodeHash == codeHash) &&
        profile.data.nim == resource.data.nim &&
        profile.data.fullName == resource.data.fullName &&
        profile.data.role in ['student', 'admin', 'superAdmin', 'super_admin'] &&
        profile.data.isActive == true;
    }

    function validStudentNimIndexCreate(nim) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = getAfter(profilePath);
      return signedIn() &&
        request.resource.data.keys().hasAll(['uid', 'fullName', 'isActive']) &&
        request.resource.data.keys().hasOnly(['uid', 'fullName', 'isActive']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.isActive == true &&
        existsAfter(profilePath) &&
        profile.data.nim == nim &&
        profile.data.fullName == request.resource.data.fullName &&
        profile.data.role == 'student' &&
        profile.data.isActive == true;
    }

    function canPublish() {
      return isAdmin() && (
        currentRole() in ['superAdmin', 'super_admin'] ||
        (currentRole() == 'admin' &&
         get(profilePath()).data.canPublish == true)
      );
    }

    function isCurrentJakartaRadioDay(dayId) {
      let jakartaNow = request.time + duration.value(7, "h");
      let yearPart = string(jakartaNow.year());
      let monthNumber = string(jakartaNow.month());
      let dayNumber = string(jakartaNow.day());
      let monthPart = monthNumber.size() == 1 ? "0" + monthNumber : monthNumber;
      let dayPart = dayNumber.size() == 1 ? "0" + dayNumber : dayNumber;
      return dayId == yearPart + "-" + monthPart + "-" + dayPart;
    }

    function validRadioSong(dayId, memberId) {
      let data = request.resource.data;
      return data.keys().hasAll([
        'uid', 'dayKey', 'displayName', 'songTitle', 'artistName',
        'albumName', 'artworkUrl', 'artworkSource', 'storeUrl',
        'story', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'dayKey', 'displayName', 'songTitle', 'artistName',
        'albumName', 'artworkUrl', 'artworkSource', 'storeUrl',
        'story', 'createdAt', 'updatedAt'
      ]) &&
      data.uid == memberId &&
      data.dayKey == dayId &&
      data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.displayName is string &&
      data.displayName.size() > 0 &&
      data.displayName.size() <= 80 &&
      data.songTitle is string &&
      data.songTitle.size() > 0 &&
      data.songTitle.size() <= 120 &&
      data.artistName is string &&
      data.artistName.size() > 0 &&
      data.artistName.size() <= 100 &&
      data.albumName is string &&
      data.albumName.size() <= 160 &&
      data.artworkUrl is string &&
      data.artworkUrl.size() > 0 &&
      data.artworkUrl.size() <= 2048 &&
      data.artworkUrl.matches('^https://.*') &&
      data.artworkSource in ['itunes', 'upload'] &&
      data.storeUrl is string &&
      data.storeUrl.size() <= 2048 &&
      (data.storeUrl == '' || data.storeUrl.matches('^https://.*')) &&
      data.story is string &&
      data.story.size() <= 240 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function sourceImportIsPublished() {
      let uploadId = resource.data.sourceUploadId;
      let manifestPath = /databases/$(database)/documents/publishedImports/$(uploadId);
      return uploadId is string &&
        exists(manifestPath) &&
        get(manifestPath).data.status == 'published';
    }

    function validAssessmentData() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'subjectId', 'subjectName', 'assessmentName',
        'category', 'maxScore', 'isPublished'
      ]) &&
      data.subjectId is string &&
      data.subjectName is string &&
      data.assessmentName is string &&
      data.category is string &&
      data.maxScore is number &&
      data.maxScore > 0 &&
      data.maxScore <= 100 &&
      data.isPublished is bool;
    }

    function validScoreData() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'studentId', 'subjectId', 'subjectName',
        'assessmentId', 'assessmentName',
        'score', 'maxScore', 'isPublished'
      ]) &&
      data.studentId is string &&
      data.subjectId is string &&
      data.subjectName is string &&
      data.assessmentId is string &&
      data.assessmentName is string &&
      data.maxScore is number &&
      data.maxScore > 0 &&
      data.maxScore <= 100 &&
      data.isPublished is bool &&
      (data.score == null ||
        (data.score is number &&
         data.score >= 0 &&
         data.score <= data.maxScore));
    }

    // STELLARS Open Letters — one persistent letter per active member account.
    function validOpenLetter() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'authorName', 'isAnonymous', 'title', 'message', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'authorName', 'isAnonymous', 'title', 'message', 'createdAt', 'updatedAt'
      ]) &&
      data.authorName is string &&
      data.authorName.size() > 0 &&
      data.authorName.size() <= 100 &&
      data.isAnonymous is bool &&
      (data.isAnonymous == true
        ? data.authorName == 'Anonymous Star'
        : data.authorName == get(profilePath()).data.fullName) &&
      data.title is string &&
      data.title.size() <= 90 &&
      data.message is string &&
      data.message.size() > 0 &&
      data.message.size() <= 2200 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function letterOwnerPath(memberId) {
      return /databases/$(database)/documents/openLetterOwners/$(memberId);
    }

    function ownsOpenLetter(letterId) {
      let ownerPath = letterOwnerPath(request.auth.uid);
      return activeMember() && (
        request.auth.uid == letterId ||
        (exists(ownerPath) && get(ownerPath).data.letterId == letterId)
      );
    }

    function hasMatchingLetterOwnerAfter(letterId) {
      let ownerPath = letterOwnerPath(request.auth.uid);
      return existsAfter(ownerPath) &&
        getAfter(ownerPath).data.letterId == letterId &&
        getAfter(ownerPath).data.fullName == get(profilePath()).data.fullName;
    }

    function validOpenLetterOwner(memberId) {
      let data = request.resource.data;
      return data.keys().hasAll(['letterId', 'fullName', 'createdAt']) &&
        data.keys().hasOnly(['letterId', 'fullName', 'createdAt']) &&
        data.letterId is string &&
        data.letterId.size() > 0 &&
        data.letterId.size() <= 128 &&
        data.fullName == get(profilePath()).data.fullName &&
        data.createdAt is timestamp;
    }

    match /openLetters/{letterId} {
      // Public letter content is available only to active STELLARS members.
      // New document IDs are random and do not expose the author's UID.
      allow get, list: if activeMember();

      allow create: if activeMember() &&
        validOpenLetter() &&
        hasMatchingLetterOwnerAfter(letterId);

      // Owners may update a random-ID letter through their private owner mapping.
      // The UID-keyed condition is retained only for legacy letters awaiting migration.
      allow update: if ownsOpenLetter(letterId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'isAnonymous', 'title', 'message', 'updatedAt'
        ]) &&
        validOpenLetter();

      // An owner can remove a legacy UID-keyed letter only as part of an atomic move
      // to a random ID with a newly created private owner mapping.
      allow delete: if isAdmin() || (
        activeMember() &&
        request.auth.uid == letterId &&
        existsAfter(letterOwnerPath(request.auth.uid)) &&
        getAfter(letterOwnerPath(request.auth.uid)).data.letterId != letterId
      );
    }

    // Private mapping between a member account and its public random-ID letter.
    // Only that member and the designated safety moderator can read it.
    match /openLetterOwners/{memberId} {
      allow get: if (activeMember() && request.auth.uid == memberId) ||
        isLetterModerator();
      allow list: if isLetterModerator();
      allow create: if activeMember() &&
        request.auth.uid == memberId &&
        !exists(letterOwnerPath(memberId)) &&
        validOpenLetterOwner(memberId);
      allow update, delete: if false;
    }

        // One-to-one private Letters. Sender UID is deliberately NOT stored on the
    // recipient-readable message document, so Anonymous Star cannot be reverse-mapped.
    function privateLetterPath(letterId) {
      return /databases/$(database)/documents/privateLetters/$(letterId);
    }

    function privateSenderPath(senderUid, letterId) {
      return /databases/$(database)/documents/privateLetterSenders/$(senderUid)/letters/$(letterId);
    }

    function validPrivateLetter() {
      let data = request.resource.data;
      let recipientPath = /databases/$(database)/documents/users/$(data.recipientUid);
      return data.keys().hasAll([
        'recipientUid', 'senderName', 'isAnonymous', 'title',
        'message', 'createdAt', 'readAt'
      ]) &&
      data.keys().hasOnly([
        'recipientUid', 'senderName', 'isAnonymous', 'title',
        'message', 'createdAt', 'readAt'
      ]) &&
      data.recipientUid is string &&
      data.recipientUid.size() > 0 &&
      data.recipientUid != request.auth.uid &&
      exists(recipientPath) &&
      get(recipientPath).data.isActive == true &&
      get(recipientPath).data.role in ['student', 'admin', 'superAdmin', 'super_admin'] &&
      data.senderName is string &&
      data.senderName.size() > 0 &&
      data.senderName.size() <= 100 &&
      data.isAnonymous is bool &&
      (data.isAnonymous
        ? data.senderName == 'Anonymous Star'
        : data.senderName == get(profilePath()).data.fullName) &&
      data.title is string &&
      data.title.size() <= 90 &&
      data.message is string &&
      data.message.size() > 0 &&
      data.message.size() <= 2200 &&
      data.createdAt is timestamp &&
      data.readAt == null;
    }

    match /privateLetters/{letterId} {
      // The recipient can list their inbox. A sender can fetch only messages for
      // which their private sent-index record exists; sender UID remains hidden.
      allow get: if activeMember() && (
        resource.data.recipientUid == request.auth.uid ||
        exists(privateSenderPath(request.auth.uid, letterId))
      );
      allow list: if activeMember() &&
        resource.data.recipientUid == request.auth.uid;

      // The message and sender index must be created together in one batch.
      allow create: if activeMember() &&
        validPrivateLetter() &&
        existsAfter(privateSenderPath(request.auth.uid, letterId)) &&
        getAfter(privateSenderPath(request.auth.uid, letterId)).data.letterId == letterId;

      // Only the recipient can mark a message as read. Content and participants
      // become immutable once delivered.
      allow update: if activeMember() &&
        resource.data.recipientUid == request.auth.uid &&
        resource.data.readAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is timestamp;
      allow delete: if false;
    }

    // Sender-only archive. A self-contained copy means the sender need not
    // query the recipient's inbox or member directory to view their Sent folder.
    match /privateLetterSenders/{senderUid}/letters/{letterId} {
      allow get, list: if activeMember() && request.auth.uid == senderUid;
      allow create: if activeMember() &&
        request.auth.uid == senderUid &&
        !exists(privateLetterPath(letterId)) &&
        existsAfter(privateLetterPath(letterId)) &&
        request.resource.data.keys().hasAll([
          'letterId', 'recipientUid', 'recipientName', 'senderName',
          'isAnonymous', 'title', 'message', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'letterId', 'recipientUid', 'recipientName', 'senderName',
          'isAnonymous', 'title', 'message', 'createdAt'
        ]) &&
        request.resource.data.letterId == letterId &&
        request.resource.data.recipientUid is string &&
        request.resource.data.recipientUid != senderUid &&
        request.resource.data.recipientName is string &&
        request.resource.data.recipientName.size() > 0 &&
        request.resource.data.recipientName.size() <= 100 &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() > 0 &&
        request.resource.data.senderName.size() <= 100 &&
        request.resource.data.isAnonymous is bool &&
        (request.resource.data.isAnonymous
          ? request.resource.data.senderName == 'Anonymous Star'
          : request.resource.data.senderName == get(profilePath()).data.fullName) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 90 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2200 &&
        request.resource.data.createdAt is timestamp &&
        getAfter(privateLetterPath(letterId)).data.recipientUid == request.resource.data.recipientUid &&
        getAfter(privateLetterPath(letterId)).data.senderName == request.resource.data.senderName &&
        getAfter(privateLetterPath(letterId)).data.isAnonymous == request.resource.data.isAnonymous &&
        getAfter(privateLetterPath(letterId)).data.title == request.resource.data.title &&
        getAfter(privateLetterPath(letterId)).data.message == request.resource.data.message &&
        getAfter(privateLetterPath(letterId)).data.createdAt == request.resource.data.createdAt;
      allow update, delete: if false;
    }

    // Path-scoped private mailbox: received and sent copies live under the owner's UID.
    // The recipient's copy never stores the sender UID, so anonymous senders stay anonymous.
    function mailboxReceivedPath(recipientUid, letterId) {
      return /databases/$(database)/documents/privateMailboxes/$(recipientUid)/received/$(letterId);
    }

    function mailboxSentPath(senderUid, letterId) {
      return /databases/$(database)/documents/privateMailboxes/$(senderUid)/sent/$(letterId);
    }

    function validMailboxSent(ownerUid, letterId) {
      let data = request.resource.data;
      let recipientProfilePath = /databases/$(database)/documents/users/$(data.recipientUid);
      let receivedPath = mailboxReceivedPath(data.recipientUid, letterId);
      return ownerUid == request.auth.uid &&
        data.keys().hasAll([
          'letterId', 'recipientUid', 'recipientName', 'senderName',
          'isAnonymous', 'title', 'message', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'letterId', 'recipientUid', 'recipientName', 'senderName',
          'isAnonymous', 'title', 'message', 'createdAt'
        ]) &&
        data.letterId == letterId &&
        data.recipientUid is string &&
        data.recipientUid != ownerUid &&
        exists(recipientProfilePath) &&
        get(recipientProfilePath).data.isActive == true &&
        get(recipientProfilePath).data.role in ['student', 'admin', 'superAdmin', 'super_admin'] &&
        data.recipientName is string &&
        data.recipientName.size() > 0 &&
        data.recipientName.size() <= 100 &&
        data.senderName is string &&
        data.senderName.size() > 0 &&
        data.senderName.size() <= 100 &&
        data.isAnonymous is bool &&
        (data.isAnonymous
          ? data.senderName == 'Anonymous Star'
          : data.senderName == get(profilePath()).data.fullName) &&
        data.title is string &&
        data.title.size() <= 90 &&
        data.message is string &&
        data.message.size() > 0 &&
        data.message.size() <= 2200 &&
        data.createdAt is timestamp &&
        existsAfter(receivedPath) &&
        getAfter(receivedPath).data.senderName == data.senderName &&
        getAfter(receivedPath).data.isAnonymous == data.isAnonymous &&
        getAfter(receivedPath).data.title == data.title &&
        getAfter(receivedPath).data.message == data.message &&
        getAfter(receivedPath).data.createdAt == data.createdAt;
    }

    function validMailboxReceived(ownerUid, letterId) {
      let data = request.resource.data;
      let senderPath = mailboxSentPath(request.auth.uid, letterId);
      return ownerUid != request.auth.uid &&
        data.keys().hasAll([
          'senderName', 'isAnonymous', 'title', 'message', 'createdAt', 'readAt'
        ]) &&
        data.keys().hasOnly([
          'senderName', 'isAnonymous', 'title', 'message', 'createdAt', 'readAt'
        ]) &&
        data.senderName is string &&
        data.senderName.size() > 0 &&
        data.senderName.size() <= 100 &&
        data.isAnonymous is bool &&
        (data.isAnonymous
          ? data.senderName == 'Anonymous Star'
          : data.senderName is string) &&
        data.title is string &&
        data.title.size() <= 90 &&
        data.message is string &&
        data.message.size() > 0 &&
        data.message.size() <= 2200 &&
        data.createdAt is timestamp &&
        data.readAt == null &&
        existsAfter(senderPath) &&
        getAfter(senderPath).data.recipientUid == ownerUid &&
        getAfter(senderPath).data.senderName == data.senderName &&
        getAfter(senderPath).data.isAnonymous == data.isAnonymous &&
        getAfter(senderPath).data.title == data.title &&
        getAfter(senderPath).data.message == data.message &&
        getAfter(senderPath).data.createdAt == data.createdAt;
    }

    match /privateMailboxes/{ownerUid}/{folder}/{letterId} {
      // Each member can read only their own Received and Sent subcollections.
      allow get, list: if activeMember() &&
        request.auth.uid == ownerUid &&
        folder in ['received', 'sent'];

      // Both recipient and sender copies must be created atomically.
      allow create: if activeMember() && (
        (folder == 'sent' && validMailboxSent(ownerUid, letterId)) ||
        (folder == 'received' && validMailboxReceived(ownerUid, letterId))
      );

      // Only the recipient can change readAt, and only once.
      allow update: if activeMember() &&
        request.auth.uid == ownerUid &&
        folder == 'received' &&
        resource.data.readAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is timestamp;
      allow delete: if false;
    }

// Library media metadata. Legacy entries without visibility remain member-only.
    function validMemoryCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'imageUrl', 'mediaType', 'cloudinaryPublicId', 'category',
        'title', 'description', 'createdAt', 'uploadedBy',
        'visibility', 'publicConsent'
      ]) &&
      data.keys().hasOnly([
        'imageUrl', 'mediaType', 'cloudinaryPublicId', 'category',
        'title', 'description', 'createdAt', 'uploadedBy',
        'visibility', 'publicConsent'
      ]) &&
      data.imageUrl is string &&
      data.imageUrl.matches('^https://.*') &&
      data.imageUrl.size() <= 2048 &&
      data.mediaType in ['image', 'video'] &&
      (data.cloudinaryPublicId == null ||
       (data.cloudinaryPublicId is string && data.cloudinaryPublicId.size() <= 255)) &&
      data.category is string && data.category.size() > 0 && data.category.size() <= 40 &&
      data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
      data.description is string && data.description.size() <= 300 &&
      data.createdAt is timestamp &&
      data.uploadedBy == request.auth.uid &&
      data.visibility == 'public' &&
      data.publicConsent == true;
    }

    function validMemoryAdminUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'imageUrl', 'mediaType', 'cloudinaryPublicId',
        'category', 'title', 'description', 'visibility',
        'publicConsent', 'updatedAt', 'updatedBy'
      ]) &&
      data.imageUrl is string &&
      data.imageUrl.matches('^https://.*') &&
      data.imageUrl.size() <= 2048 &&
      (!data.keys().hasAny(['mediaType']) || data.mediaType in ['image', 'video']) &&
      (!data.keys().hasAny(['cloudinaryPublicId']) ||
       data.cloudinaryPublicId == null ||
       (data.cloudinaryPublicId is string && data.cloudinaryPublicId.size() <= 255)) &&
      data.category is string && data.category.size() > 0 && data.category.size() <= 40 &&
      data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
      data.description is string && data.description.size() <= 300 &&
      data.visibility == 'public' &&
      data.publicConsent == true &&
      (!resource.data.keys().hasAny(['uploadedBy']) ||
       data.uploadedBy == resource.data.uploadedBy) &&
      data.createdAt == resource.data.createdAt &&
      data.updatedAt is timestamp &&
      data.updatedBy == request.auth.uid;
    }

    match /memories/{memoryId} {
      // Library is a private STELLARS member space.
      allow get, list: if activeMember();
      allow create: if activeMember() && validMemoryCreate();
      allow update: if canManageLibrary() && validMemoryAdminUpdate();
      // Deletion remains reserved for SuperAdmin, never Library Editors.
      allow delete: if isSuperAdmin();
    }

    // Daily Music Diary: active STELLARS members can see today's wall.
    // Each member's UID is the document ID, so only one entry is active per day.

    // STELLARS Pulse — daily random poll, Jakarta time.
    function isPulseVotingOpen() {
      let jakartaNow = request.time + duration.value(7, "h");
      return (
        (jakartaNow.hours() > 9 ||
         (jakartaNow.hours() == 9 && jakartaNow.minutes() >= 30)) &&
        jakartaNow.hours() < 13
      );
    }

    function isPulseVotingClosed() {
      let jakartaNow = request.time + duration.value(7, "h");
      return jakartaNow.hours() >= 13;
    }

    function pulseRosterIds() {
      return ['quinetta-aulya-winata', 'darren-leinad-cahaya', 'vianney-yovella-kristanto', 'levinne-emerson-mulia', 'delfina-calista-ciu-putri', 'kelly-patricia-ongkodjojo', 'felicia-zefanya', 'nicke-amelia-trijono', 'tesalonika-uli-putri-silalahi', 'ersya-fely', 'shareen-tesalonika-setiawan', 'marsha-setiawan', 'anita-lestari-elisabet', 'anjelie', 'johanna-avrilla-hapsari-putri', 'kevano-mareto', 'vincent-farellius', 'elmarsha-hannabella', 'kioko-rei', 'raisya-thalita-jasmine', 'ellie-margaretta', 'jasper-vladino-alvis', 'adeline-nadia-nicola', 'andre-praditya-pratama', 'carmella-wibowo-widhianto', 'chairine-aretha-nathania', 'danniel', 'eilien-ardelia', 'grace-abigail-wijaya', 'gracielle-fellisca-tjoa', 'hosea-bowie-immanuel', 'jean-romeo-junior-sembiring', 'keely-michiko-mulyanto', 'maresha-majesty-wales', 'maya-caroline', 'pande-kadek-redita-julia-dewi', 'patricia-devina', 'putu-adelia-nariswari', 'reynard-christian', 'samantha-angel', 'stevander-rusli', 'stephanie-felita-widodo', 'chantika-anastasia', 'vivian-renata-chandra', 'zalika-afarin-azura'];
    }

    function pulseQuestionIds() {
      return ['ceo', 'chaos-mascot', 'alien-buddy', 'human-calendar', 'plot-twist', 'travel-guide', 'snack-ambassador', 'idea-machine', 'main-character', 'future-millionaire', 'tech-support', 'event-planner', 'adventure', 'peacekeeper', 'fashion-icon', 'random-facts', 'comedian', 'night-owl', 'meme-dealer', 'secret-talent', 'group-chat', 'overthinker', 'mystery-box', 'good-vibes'];
    }

    function validPulsePoll(dayId) {
      let data = request.resource.data;
      let roster = pulseRosterIds();
      return data.keys().hasAll(['dayKey', 'questionId', 'candidateIds', 'createdAt']) &&
        data.keys().hasOnly(['dayKey', 'questionId', 'candidateIds', 'createdAt']) &&
        data.dayKey == dayId &&
        data.questionId is string &&
        data.questionId in pulseQuestionIds() &&
        data.candidateIds is list &&
        data.candidateIds.size() == 4 &&
        data.candidateIds[0] in roster &&
        data.candidateIds[1] in roster &&
        data.candidateIds[2] in roster &&
        data.candidateIds[3] in roster &&
        data.candidateIds[0] != data.candidateIds[1] &&
        data.candidateIds[0] != data.candidateIds[2] &&
        data.candidateIds[0] != data.candidateIds[3] &&
        data.candidateIds[1] != data.candidateIds[2] &&
        data.candidateIds[1] != data.candidateIds[3] &&
        data.candidateIds[2] != data.candidateIds[3] &&
        data.createdAt is timestamp;
    }

    function validPulseVote(dayId, memberId) {
      let data = request.resource.data;
      let pollPath = /databases/$(database)/documents/pulseDays/$(dayId);
      let poll = get(pollPath);
      return exists(pollPath) &&
        data.keys().hasAll(['uid', 'dayKey', 'questionId', 'candidateId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'dayKey', 'questionId', 'candidateId', 'createdAt']) &&
        data.uid == memberId &&
        data.dayKey == dayId &&
        data.questionId == poll.data.questionId &&
        data.candidateId in poll.data.candidateIds &&
        data.createdAt is timestamp;
    }

    match /pulseDays/{dayId} {
      allow get, list: if activeMember() && isCurrentJakartaRadioDay(dayId);
      allow create: if activeMember() &&
        isCurrentJakartaRadioDay(dayId) &&
        isPulseVotingOpen() &&
        validPulsePoll(dayId);
      allow update, delete: if false;

      match /votes/{memberId} {
        allow get: if activeMember() &&
          isCurrentJakartaRadioDay(dayId) &&
          ((request.auth.uid == memberId && isPulseVotingOpen()) || isPulseVotingClosed());
        allow list: if activeMember() &&
          isCurrentJakartaRadioDay(dayId) &&
          isPulseVotingClosed();
        allow create: if activeMember() &&
          request.auth.uid == memberId &&
          isCurrentJakartaRadioDay(dayId) &&
          isPulseVotingOpen() &&
          validPulseVote(dayId, memberId);
        allow update, delete: if false;
      }
    }

    match /radioDays/{dayId}/songs/{memberId} {
      // Song Wall entries are public to read; posting and editing remain member-only.
      allow read: if true;
      allow create: if activeMember() &&
        request.auth.uid == memberId &&
        isCurrentJakartaRadioDay(dayId) &&
        validRadioSong(dayId, memberId);
      allow update: if activeMember() &&
        request.auth.uid == memberId &&
        resource.data.uid == memberId &&
        isCurrentJakartaRadioDay(dayId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validRadioSong(dayId, memberId);
      // Members edit their own entry; only the scheduled backend deletes old days.
      allow delete: if false;
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['birthDate', 'slogan']) &&
        request.resource.data.keys().hasAll(['birthDate', 'slogan']) &&
        request.resource.data.birthDate is string &&
        request.resource.data.birthDate.size() <= 10 &&
        request.resource.data.slogan is string &&
        request.resource.data.slogan.size() <= 120;
    }

    match /activationCodes/{codeHash} {
      // Individual get is required for registration; enumeration is admin-only.
      // The 80-bit one-time code is represented in Firestore only by its SHA-256 hash.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validActivationCodeCreate();
      allow update: if validActivationCodeRedemption(codeHash);
      allow delete: if isAdmin() && resource.data.status == 'available';
    }

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validStudentProfileCreate(userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.isActive == true &&
        validSelfProfileUpdate();
      allow delete: if false;
    }

    function validBirthdayMonthDay(value) {
      return value is string &&
        value.matches('^(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$|^(04|06|09|11)-(0[1-9]|[12][0-9]|30)$|^02-(0[1-9]|1[0-9]|2[0-9])$');
    }

    match /nimIndex/{nim} {
      // Active members can search the minimal directory fields (UID, name, NIM, status).
      allow get: if activeMember() && resource.data.isActive == true;
      allow list: if activeMember() &&
        request.query.limit <= 100 &&
        resource.data.isActive == true;
      allow create: if validStudentNimIndexCreate(nim);
      allow update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if activeMember();
      allow create, update, delete: if isAdmin();
    }

    match /assessments/{assessmentId} {
      allow get, list: if isAdmin() ||
        (activeMember() && resource.data.isPublished == true);

      allow create: if validAssessmentData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validAssessmentData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /publishedImports/{uploadId} {
      allow get, list: if isAdmin() ||
        (isStudent() && resource.data.status == 'published');
      allow create, update, delete: if canPublish();
    }

    match /scores/{scoreId} {
      allow get, list: if isAdmin() ||
        (isStudent() &&
         resource.data.studentId == request.auth.uid &&
         resource.data.isPublished == true &&
         sourceImportIsPublished());

      allow create: if validScoreData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validScoreData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /uploads/{uploadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
);
    }

    function isBirthdayMember() {
      return activeMember() &&
        currentRole() in ['student', 'member', 'admin', 'superAdmin', 'super_admin'];
    }

    // All birthday names and dates are visible only to active class accounts.
    match /birthdayDirectory/{memberId} {
      allow get, list: if isBirthdayMember();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.keys().hasAll(['fullName', 'birthMonthDay']) &&
        request.resource.data.keys().hasOnly(['fullName', 'birthMonthDay']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 100 &&
        validBirthdayMonthDay(request.resource.data.birthMonthDay);
      allow delete: if isSuperAdmin();
    }

    // No public Birthday preview document is readable. Missing rules deny access.
    
    match /nimIndex/{nim} {
      // Active members can search the minimal directory fields (UID, name, NIM, status).
      allow get: if activeMember() && resource.data.isActive == true;
      allow list: if activeMember() &&
        request.query.limit <= 100 &&
        resource.data.isActive == true;
      allow create: if validStudentNimIndexCreate(nim);
      allow update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if activeMember();
      allow create, update, delete: if isAdmin();
    }

    match /assessments/{assessmentId} {
      allow get, list: if isAdmin() ||
        (activeMember() && resource.data.isPublished == true);

      allow create: if validAssessmentData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validAssessmentData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /publishedImports/{uploadId} {
      allow get, list: if isAdmin() ||
        (isStudent() && resource.data.status == 'published');
      allow create, update, delete: if canPublish();
    }

    match /scores/{scoreId} {
      allow get, list: if isAdmin() ||
        (isStudent() &&
         resource.data.studentId == request.auth.uid &&
         resource.data.isPublished == true &&
         sourceImportIsPublished());

      allow create: if validScoreData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validScoreData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /uploads/{uploadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
