rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function activeMember() {
      return hasProfile() && get(profilePath()).data.isActive == true;
    }

    function currentRole() {
      return get(profilePath()).data.role;
    }

    function isAdmin() {
      return activeMember() && currentRole() in ['admin', 'superAdmin', 'super_admin'];
    }

    function isSuperAdmin() {
      return activeMember() && currentRole() in ['superAdmin', 'super_admin'];
    }

    function isStudent() {
      return activeMember() && currentRole() == 'student';
    }

    function validActivationCodeCreate() {
      let data = request.resource.data;
      let nimPath = /databases/$(database)/documents/nimIndex/$(data.nim);
      return isAdmin() &&
        data.keys().hasAll(['fullName', 'nim', 'status', 'createdAt', 'createdBy']) &&
        data.keys().hasOnly(['fullName', 'nim', 'status', 'createdAt', 'createdBy']) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.nim is string &&
        data.nim.matches('^[0-9]{5,24}$') &&
        data.status == 'available' &&
        data.createdAt is timestamp &&
        data.createdBy == request.auth.uid;
    }

    function validStudentProfileCreate(userId) {
      let data = request.resource.data;
      let activationPath = /databases/$(database)/documents/activationCodes/$(data.activationCodeHash);
      let activation = getAfter(activationPath);
      let nimIndexPath = /databases/$(database)/documents/nimIndex/$(data.nim);
      let nimIndex = getAfter(nimIndexPath);
      return signedIn() &&
        request.auth.uid == userId &&
        data.keys().hasAll([
          'fullName', 'username', 'nim', 'role', 'isActive',
          'birthDate', 'slogan', 'activationCodeHash', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'fullName', 'username', 'nim', 'role', 'isActive',
          'birthDate', 'slogan', 'activationCodeHash', 'createdAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.nim is string &&
        data.nim.matches('^[0-9]{5,24}$') &&
        data.username == data.nim &&
        data.role == 'student' &&
        data.isActive == true &&
        data.birthDate == '' &&
        data.slogan == '' &&
        data.activationCodeHash is string &&
        data.activationCodeHash.matches('^[0-9a-f]{64}$') &&
        data.createdAt is timestamp &&
        existsAfter(activationPath) &&
        activation.data.status == 'redeemed' &&
        activation.data.redeemedBy == userId &&
        activation.data.nim == data.nim &&
        activation.data.fullName == data.fullName &&
        existsAfter(nimIndexPath) &&
        nimIndex.data.uid == userId &&
        nimIndex.data.fullName == data.fullName &&
        nimIndex.data.isActive == true;
    }

    function validActivationCodeRedemption(codeHash) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = getAfter(profilePath);
      let profileHasActivationHash = 'activationCodeHash' in profile.data.keys();
      return signedIn() &&
        resource.data.status == 'available' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedBy', 'redeemedAt']) &&
        request.resource.data.status == 'redeemed' &&
        request.resource.data.redeemedBy == request.auth.uid &&
        request.resource.data.redeemedAt is timestamp &&
        existsAfter(profilePath) &&
        (!profileHasActivationHash || profile.data.activationCodeHash == codeHash) &&
        profile.data.nim == resource.data.nim &&
        profile.data.fullName == resource.data.fullName &&
        profile.data.role in ['student', 'admin', 'superAdmin', 'super_admin'] &&
        profile.data.isActive == true;
    }

    function validStudentNimIndexCreate(nim) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = getAfter(profilePath);
      return signedIn() &&
        request.resource.data.keys().hasAll(['uid', 'fullName', 'isActive']) &&
        request.resource.data.keys().hasOnly(['uid', 'fullName', 'isActive']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.isActive == true &&
        existsAfter(profilePath) &&
        profile.data.nim == nim &&
        profile.data.fullName == request.resource.data.fullName &&
        profile.data.role == 'student' &&
        profile.data.isActive == true;
    }

    function canPublish() {
      return isAdmin() && (
        currentRole() in ['superAdmin', 'super_admin'] ||
        (currentRole() == 'admin' &&
         get(profilePath()).data.canPublish == true)
      );
    }

    function isCurrentJakartaRadioDay(dayId) {
      let jakartaNow = request.time + duration.value(7, "h");
      let yearPart = string(jakartaNow.year());
      let monthNumber = string(jakartaNow.month());
      let dayNumber = string(jakartaNow.day());
      let monthPart = monthNumber.size() == 1 ? "0" + monthNumber : monthNumber;
      let dayPart = dayNumber.size() == 1 ? "0" + dayNumber : dayNumber;
      return dayId == yearPart + "-" + monthPart + "-" + dayPart;
    }

    function validRadioSong(dayId, memberId) {
      let data = request.resource.data;
      return data.keys().hasAll([
        'uid', 'dayKey', 'displayName', 'songTitle', 'artistName',
        'albumName', 'artworkUrl', 'artworkSource', 'storeUrl',
        'story', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'dayKey', 'displayName', 'songTitle', 'artistName',
        'albumName', 'artworkUrl', 'artworkSource', 'storeUrl',
        'story', 'createdAt', 'updatedAt'
      ]) &&
      data.uid == memberId &&
      data.dayKey == dayId &&
      data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.displayName is string &&
      data.displayName.size() > 0 &&
      data.displayName.size() <= 80 &&
      data.songTitle is string &&
      data.songTitle.size() > 0 &&
      data.songTitle.size() <= 120 &&
      data.artistName is string &&
      data.artistName.size() > 0 &&
      data.artistName.size() <= 100 &&
      data.albumName is string &&
      data.albumName.size() <= 160 &&
      data.artworkUrl is string &&
      data.artworkUrl.size() > 0 &&
      data.artworkUrl.size() <= 2048 &&
      data.artworkUrl.matches('^https://.*') &&
      data.artworkSource in ['itunes', 'upload'] &&
      data.storeUrl is string &&
      data.storeUrl.size() <= 2048 &&
      (data.storeUrl == '' || data.storeUrl.matches('^https://.*')) &&
      data.story is string &&
      data.story.size() <= 240 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function sourceImportIsPublished() {
      let uploadId = resource.data.sourceUploadId;
      let manifestPath = /databases/$(database)/documents/publishedImports/$(uploadId);
      return uploadId is string &&
        exists(manifestPath) &&
        get(manifestPath).data.status == 'published';
    }

    function validAssessmentData() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'subjectId', 'subjectName', 'assessmentName',
        'category', 'maxScore', 'isPublished'
      ]) &&
      data.subjectId is string &&
      data.subjectName is string &&
      data.assessmentName is string &&
      data.category is string &&
      data.maxScore is number &&
      data.maxScore > 0 &&
      data.maxScore <= 100 &&
      data.isPublished is bool;
    }

    function validScoreData() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'studentId', 'subjectId', 'subjectName',
        'assessmentId', 'assessmentName',
        'score', 'maxScore', 'isPublished'
      ]) &&
      data.studentId is string &&
      data.subjectId is string &&
      data.subjectName is string &&
      data.assessmentId is string &&
      data.assessmentName is string &&
      data.maxScore is number &&
      data.maxScore > 0 &&
      data.maxScore <= 100 &&
      data.isPublished is bool &&
      (data.score == null ||
        (data.score is number &&
         data.score >= 0 &&
         data.score <= data.maxScore));
    }

    // STELLARS Open Letters — one persistent letter per active member account.
    function validOpenLetter() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'authorName', 'isAnonymous', 'title', 'message', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'authorName', 'isAnonymous', 'title', 'message', 'createdAt', 'updatedAt'
      ]) &&
      data.authorName is string &&
      data.authorName.size() > 0 &&
      data.authorName.size() <= 100 &&
      data.isAnonymous is bool &&
      (data.isAnonymous == true
        ? data.authorName == 'Anonymous Star'
        : data.authorName == get(profilePath()).data.fullName) &&
      data.title is string &&
      data.title.size() <= 90 &&
      data.message is string &&
      data.message.size() > 0 &&
      data.message.size() <= 2200 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /openLetters/{memberId} {
      allow get, list: if activeMember();

      // Document ID is the member UID, so each account has one permanent slot.
      allow create: if activeMember() &&
        request.auth.uid == memberId &&
        !exists(/databases/$(database)/documents/openLetters/$(memberId)) &&
        validOpenLetter();

      // Members may revise their own existing letter, but cannot create another one.
      allow update: if activeMember() &&
        request.auth.uid == memberId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authorName', 'isAnonymous', 'title', 'message', 'updatedAt'
        ]) &&
        validOpenLetter();

      // Admins can remove content that needs moderation; members cannot delete and repost.
      allow delete: if isAdmin();
    }

    // Existing STELLARS Library access is retained.
    match /memories/{memoryId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Daily Music Diary: active STELLARS members can see today's wall.
    // Each member's UID is the document ID, so only one entry is active per day.

    // STELLARS Pulse — daily random poll, Jakarta time.
    function isPulseVotingOpen() {
      let jakartaNow = request.time + duration.value(7, "h");
      return (
        (jakartaNow.hours() > 9 ||
         (jakartaNow.hours() == 9 && jakartaNow.minutes() >= 30)) &&
        jakartaNow.hours() < 13
      );
    }

    function isPulseVotingClosed() {
      let jakartaNow = request.time + duration.value(7, "h");
      return jakartaNow.hours() >= 13;
    }

    function pulseRosterIds() {
      return ['quinetta-aulya-winata', 'darren-leinad-cahaya', 'vianney-yovella-kristanto', 'levinne-emerson-mulia', 'delfina-calista-ciu-putri', 'kelly-patricia-ongkodjojo', 'felicia-zefanya', 'nicke-amelia-trijono', 'tesalonika-uli-putri-silalahi', 'ersya-fely', 'shareen-tesalonika-setiawan', 'marsha-setiawan', 'anita-lestari-elisabet', 'anjelie', 'johanna-avrilla-hapsari-putri', 'kevano-mareto', 'vincent-farellius', 'elmarsha-hannabella', 'kioko-rei', 'raisya-thalita-jasmine', 'ellie-margaretta', 'jasper-vladino-alvis', 'adeline-nadia-nicola', 'andre-praditya-pratama', 'carmella-wibowo-widhianto', 'chairine-aretha-nathania', 'danniel', 'eilien-ardelia', 'grace-abigail-wijaya', 'gracielle-fellisca-tjoa', 'hosea-bowie-immanuel', 'jean-romeo-junior-sembiring', 'keely-michiko-mulyanto', 'maresha-majesty-wales', 'maya-caroline', 'pande-kadek-redita-julia-dewi', 'patricia-devina', 'putu-adelia-nariswari', 'reynard-christian', 'samantha-angel', 'stevander-rusli', 'stephanie-felita-widodo', 'chantika-anastasia', 'vivian-renata-chandra', 'zalika-afarin-azura'];
    }

    function pulseQuestionIds() {
      return ['ceo', 'chaos-mascot', 'alien-buddy', 'human-calendar', 'plot-twist', 'travel-guide', 'snack-ambassador', 'idea-machine', 'main-character', 'future-millionaire', 'tech-support', 'event-planner', 'adventure', 'peacekeeper', 'fashion-icon', 'random-facts', 'comedian', 'night-owl', 'meme-dealer', 'secret-talent', 'group-chat', 'overthinker', 'mystery-box', 'good-vibes'];
    }

    function validPulsePoll(dayId) {
      let data = request.resource.data;
      let roster = pulseRosterIds();
      return data.keys().hasAll(['dayKey', 'questionId', 'candidateIds', 'createdAt']) &&
        data.keys().hasOnly(['dayKey', 'questionId', 'candidateIds', 'createdAt']) &&
        data.dayKey == dayId &&
        data.questionId is string &&
        data.questionId in pulseQuestionIds() &&
        data.candidateIds is list &&
        data.candidateIds.size() == 4 &&
        data.candidateIds[0] in roster &&
        data.candidateIds[1] in roster &&
        data.candidateIds[2] in roster &&
        data.candidateIds[3] in roster &&
        data.candidateIds[0] != data.candidateIds[1] &&
        data.candidateIds[0] != data.candidateIds[2] &&
        data.candidateIds[0] != data.candidateIds[3] &&
        data.candidateIds[1] != data.candidateIds[2] &&
        data.candidateIds[1] != data.candidateIds[3] &&
        data.candidateIds[2] != data.candidateIds[3] &&
        data.createdAt is timestamp;
    }

    function validPulseVote(dayId, memberId) {
      let data = request.resource.data;
      let pollPath = /databases/$(database)/documents/pulseDays/$(dayId);
      let poll = get(pollPath);
      return exists(pollPath) &&
        data.keys().hasAll(['uid', 'dayKey', 'questionId', 'candidateId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'dayKey', 'questionId', 'candidateId', 'createdAt']) &&
        data.uid == memberId &&
        data.dayKey == dayId &&
        data.questionId == poll.data.questionId &&
        data.candidateId in poll.data.candidateIds &&
        data.createdAt is timestamp;
    }

    match /pulseDays/{dayId} {
      allow get, list: if activeMember() && isCurrentJakartaRadioDay(dayId);
      allow create: if activeMember() &&
        isCurrentJakartaRadioDay(dayId) &&
        isPulseVotingOpen() &&
        validPulsePoll(dayId);
      allow update, delete: if false;

      match /votes/{memberId} {
        allow get: if activeMember() &&
          isCurrentJakartaRadioDay(dayId) &&
          ((request.auth.uid == memberId && isPulseVotingOpen()) || isPulseVotingClosed());
        allow list: if activeMember() &&
          isCurrentJakartaRadioDay(dayId) &&
          isPulseVotingClosed();
        allow create: if activeMember() &&
          request.auth.uid == memberId &&
          isCurrentJakartaRadioDay(dayId) &&
          isPulseVotingOpen() &&
          validPulseVote(dayId, memberId);
        allow update, delete: if false;
      }
    }

    match /radioDays/{dayId}/songs/{memberId} {
      allow read: if activeMember();
      allow create: if activeMember() &&
        request.auth.uid == memberId &&
        isCurrentJakartaRadioDay(dayId) &&
        validRadioSong(dayId, memberId);
      allow update: if activeMember() &&
        request.auth.uid == memberId &&
        resource.data.uid == memberId &&
        isCurrentJakartaRadioDay(dayId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validRadioSong(dayId, memberId);
      // Members edit their own entry; only the scheduled backend deletes old days.
      allow delete: if false;
    }

    function validSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['birthDate', 'slogan']) &&
        request.resource.data.keys().hasAll(['birthDate', 'slogan']) &&
        request.resource.data.birthDate is string &&
        request.resource.data.birthDate.size() <= 10 &&
        request.resource.data.slogan is string &&
        request.resource.data.slogan.size() <= 120;
    }

    match /activationCodes/{codeHash} {
      // Individual get is required for registration; enumeration is admin-only.
      // The 80-bit one-time code is represented in Firestore only by its SHA-256 hash.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validActivationCodeCreate();
      allow update: if validActivationCodeRedemption(codeHash);
      allow delete: if isAdmin() && resource.data.status == 'available';
    }

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validStudentProfileCreate(userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        resource.data.isActive == true &&
        validSelfProfileUpdate();
      allow delete: if false;
    }

    match /nimIndex/{nim} {
      allow read: if isAdmin();
      allow create: if validStudentNimIndexCreate(nim);
      allow update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if activeMember();
      allow create, update, delete: if isAdmin();
    }

    match /assessments/{assessmentId} {
      allow get, list: if isAdmin() ||
        (activeMember() && resource.data.isPublished == true);

      allow create: if validAssessmentData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validAssessmentData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /publishedImports/{uploadId} {
      allow get, list: if isAdmin() ||
        (isStudent() && resource.data.status == 'published');
      allow create, update, delete: if canPublish();
    }

    match /scores/{scoreId} {
      allow get, list: if isAdmin() ||
        (isStudent() &&
         resource.data.studentId == request.auth.uid &&
         resource.data.isPublished == true &&
         sourceImportIsPublished());

      allow create: if validScoreData() && (
        (isAdmin() && request.resource.data.isPublished == false) ||
        (canPublish() && request.resource.data.isPublished == true)
      );

      allow update: if validScoreData() && (
        (isAdmin() &&
         resource.data.isPublished == false &&
         request.resource.data.isPublished == false) ||
        canPublish()
      );

      allow delete: if canPublish() ||
        (isAdmin() && resource.data.isPublished == false);
    }

    match /uploads/{uploadId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}