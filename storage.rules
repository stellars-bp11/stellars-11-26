rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function activeMember() {
      return request.auth != null &&
        firestore.exists(profilePath()) &&
        firestore.get(profilePath()).data.isActive == true &&
        firestore.get(profilePath()).data.role in [
          'student', 'admin', 'superAdmin', 'super_admin'
        ];
    }

    function canManageLibrary() {
      return activeMember() && (
        firestore.get(profilePath()).data.role in ['superAdmin', 'super_admin'] ||
        firestore.get(profilePath()).data.canManageLibrary == true
      );
    }

    function validLibraryMediaUpload() {
      return request.resource != null && (
        (
          request.resource.contentType.matches('image/.*') &&
          request.resource.size <= 5 * 1024 * 1024
        ) ||
        (
          request.resource.contentType.matches('video/.*') &&
          request.resource.size <= 50 * 1024 * 1024
        )
      );
    }

    match /library-class-only/{memoryId}/{fileName} {
      // Every active STELLARS member can view Class Only media.
      allow read: if activeMember();

      // Active members may add a new memory asset.
      allow create: if activeMember() && validLibraryMediaUpload();

      // Replacements and cleanup are reserved for Library editors and SuperAdmins.
      allow update: if canManageLibrary() && validLibraryMediaUpload();
      allow delete: if activeMember() && (
        canManageLibrary() ||
        resource.metadata.uploadedBy == request.auth.uid
      );
    }
  }
}
